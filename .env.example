# iPOST OTK — sozlamalar namunasi. `.env` nomi bilan nusxalang va to'ldiring. Tekshiruv: src/shared/env.ts (zod) —
# noto'g'ri bo'lsa server ishga tushmaydi va qaysi qiymat xato ekanini aytadi.
# Batafsil: docs/JOYLASHTIRISH.md

# ── Ma'lumotlar bazasi (PostgreSQL) ───────────────────────────────────────────
# Ofis serveri: shu serverdagi (yoki ichki tarmoqdagi) o'z PostgreSQL.
DATABASE_URL="postgresql://otk:PAROL@localhost:5432/otk_crm"

# Prisma migrate uchun to'g'ridan-to'g'ri ulanish (pooler'siz). Pooler bo'lmasa DATABASE_URL bilan bir xil.
DIRECT_URL="postgresql://otk:PAROL@localhost:5432/otk_crm"

# ── Sessiya ───────────────────────────────────────────────────────────────────
# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# O'zgartirsangiz hamma ochiq sessiyalar tugaydi (hamma qayta kiradi).
AUTH_SECRET="bu-qiymatni-albatta-o-zgartiring-kamida-32-belgi"

# Sessiya cookie'siga «Secure» bayrog'i. Standart: production'da yoqilgan (faqat HTTPS).
# Ofis tarmog'ida HTTPS bo'lmasa (http://192.168.x.x:3100) brauzer Secure cookie'ni SAQLAMAYDI va kirib bo'lmaydi —
# shunda "false" qiling. HTTPS (reverse proxy) qo'ysangiz — qatorni o'chiring.
COOKIE_SECURE="false"

# Seed paytida yaratiladigan boshlang'ich parol (birinchi kirishdan keyin o'zgartiriladi)
SEED_DEFAULT_PASSWORD="Otk2026!"

# ── Ilova ─────────────────────────────────────────────────────────────────────
TZ="Asia/Tashkent"

# Jurnal darajasi: debug | info | warn | error
LOG_LEVEL="info"

# Ilova oldidagi ishonchli reverse proxylar soni (nginx, IIS ARR, Caddy). Login urinishlarini IP bo'yicha
# cheklash faqat shunda ishlaydi: proxysiz X-Forwarded-For ni mijoz soxtalashtira oladi, shuning uchun
# 0 (standart) da faqat login bo'yicha cheklov ishlaydi. Bitta proxy ortida: 1.
TRUSTED_PROXY_HOPS="0"
