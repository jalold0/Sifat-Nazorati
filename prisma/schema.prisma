// iPOST — Sifat nazorati (OTK): 12 bo'limni tekshirish tizimi (1-bosqich)
//
// Ball, foiz va xulosa HECH QAYERDA saqlanmaydi — har safar src/qc/calc.ts hisoblaydi.
// Sana (YYYY-MM-DD) Toshkent vaqti bo'yicha satr sifatida saqlanadi: tartiblash va solishtirish oddiy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  HEAD // Rahbar
  INSPECTOR // Tekshiruvchi
  VIEWER // Ko'ruvchi — faqat o'z bo'limi
  SUPERVISOR // Supervayzer — o'z bo'limida kunlik smena cheklistini to'ldiradi (docs/call-center-cheklist.md)
}

/// Bo'limdagi cheklist (chastotasi bo'yicha): har nuqta va har tekshiruv shulardan biriga tegishli.
enum QcListKind {
  SHIFT // Kunlik smena tekshiruvi
  INTERACTION // Muloqot bahosi: bitta qo'ng'iroq yoki yozishma, bitta operator
  WEEKLY // Haftalik tahlil
}

model User {
  id                 String        @id @default(cuid())
  key                String        @unique
  fullName           String
  shortName          String
  login              String        @unique
  passwordHash       String
  role               Role
  position           String
  /// Faqat ko'ruvchi uchun majburiy: u ko'radigan bo'lim
  deptId             String?
  dept               QcDepartment? @relation(fields: [deptId], references: [id])
  active             Boolean       @default(true)
  /// Keyingi kirishda parolni almashtirish majburiy (yangi hisob yoki rahbar parolni tiklaganda)
  mustChangePassword Boolean       @default(false)
  /// Sessiya versiyasi: oshirilsa, shu foydalanuvchining hamma eski sessiyalari (JWT) bekor bo'ladi
  /// (parolni almashtirish yoki qayta o'rnatish, chiqish, hisobni o'chirish).
  sessionVersion     Int           @default(0)
  lastLoginAt       DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  audits             QcAudit[]
  checkedTasks       QcTask[]
  qcTrainingTasks    QcTrainingTask[]
  qcTrainingAttempts QcTrainingAttempt[]
  qcReports          QcReport[]
  qcLogs             QcLog[]

  @@index([role, active])
}

/// Bo'lim va uning nuqtalari (nuqtalar alohida jadvalda, lekin bitta amalda saqlanadi).
model QcDepartment {
  id        String   @id @default(cuid())
  name      String
  /// Panelda tartib
  position  Int      @default(0)
  /// O'chirish o'rniga yashirish
  active    Boolean  @default(true)
  /// Umumiy ball me'yori, %
  norm      Int      @default(90)
  /// Me'yor rahbar tomonidan tasdiqlanmagan — «taxminiy»
  estimate  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkpoints      QcCheckpoint[]
  staff            QcStaff[]
  audits           QcAudit[]
  tasks            QcTask[]
  viewers          User[]
  training         QcTraining?
  trainingTasks    QcTrainingTask[]
  trainingAttempts QcTrainingAttempt[]

  @@index([active, position])
}

/// Tekshiruv nuqtasi. O'chirilmaydi — faqat `active = false` (eski tekshiruvlarda ishlatilgan).
model QcCheckpoint {
  deptId   String
  dept     QcDepartment @relation(fields: [deptId], references: [id], onDelete: Cascade)
  /// Bo'lim ichida o'zgarmas qisqa id: cp1, cp2, …
  id       String
  text     String
  grp      String?
  /// 1, 2 yoki 3
  weight   Int          @default(1)
  /// «Yo'q» bo'lsa rahbarga darhol xabar
  critical Boolean      @default(false)
  active   Boolean      @default(true)
  position Int          @default(0)
  /// Qanday baholanadi: butun bo'lim uchun Ha/Yo'q yoki har hodim uchun (docs/spec-hodimlar-kesimida.md)
  kind     QcCheckpointKind @default(CHECK)
  /// STAFF_COUNT uchun son maydonlari yorliqlari, masalan «Sifatli yopdi» / «Yopa olmadi»
  okLabel  String?
  badLabel String?
  /// Qaysi cheklistga tegishli
  list     QcListKind   @default(SHIFT)

  @@id([deptId, id])
}

enum QcCheckpointKind {
  CHECK // butun bo'lim: Ha / Yo'q / Tegishli emas
  STAFF_CHECK // har hodim: Ha / Yo'q
  STAFF_COUNT // har hodim: «yaxshi» va «yomon» soni
}

/// Tekshiriladigan bo'lim hodimi (operator, kuryer, omborchi). Tizimga kirmaydi. O'chirilmaydi — yashiriladi.
model QcStaff {
  id        String       @id @default(cuid())
  deptId    String
  dept      QcDepartment @relation(fields: [deptId], references: [id], onDelete: Cascade)
  name      String
  /// Lavozim yoki smena (ixtiyoriy), masalan «Operator, 1-smena»
  role      String       @default("")
  active    Boolean      @default(true)
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  /// Muloqot bahosida baholangan hodim sifatida
  interactionAudits QcAudit[]

  @@index([deptId, active])
}

/// Bitta tekshiruv. `byId`, `createdAt`, `updatedAt` va `critical` ni faqat server qo'yadi.
model QcAudit {
  id        String       @id @default(cuid())
  deptId    String
  dept      QcDepartment @relation(fields: [deptId], references: [id])
  /// YYYY-MM-DD
  date      String       @db.VarChar(10)
  byId      String
  by        User         @relation(fields: [byId], references: [id])
  /// { nuqtaId: "yes" | "no" | "na" }
  answers   Json
  /// { nuqtaId: { text, ref } }
  notes     Json
  /// Kim yoki nima tekshirildi (operator, smena, jo'natma raqami)
  subject   String       @default("")
  /// Jiddiy nuqtada «Yo'q» bo'lsa true
  critical  Boolean      @default(false)
  /// Kiritilgan paytdagi nuqta og'irliklari { nuqtaId: 1..3 }: keyin og'irlik o'zgarsa ham eski ball o'zgarmaydi.
  /// null — eski yozuv: joriy og'irliklar ishlatiladi.
  weights   Json?
  /// Hodimlar kesimidagi natijalar: { people: [{id, name}], results: { nuqtaId: { hodimId: yacheyka } } };
  /// yacheyka { v: yes|no|na, reason? } yoki { ok, bad, reason? }. Ismlar nusxa — keyin o'zgarsa ham tarix buzilmaydi.
  staff     Json?
  /// Qaysi cheklist bo'yicha tekshiruv
  list      QcListKind   @default(SHIFT)
  /// Muloqot bahosi: baholangan operator va kanal (phone | telegram | chat)
  staffId   String?
  staffRef  QcStaff?     @relation(fields: [staffId], references: [id])
  channel   String?      @db.VarChar(16)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tasks QcTask[]

  @@index([deptId, date])
  @@index([deptId, list, date])
  @@index([staffId])
  @@index([date])
}

enum QcTaskStatus {
  OPEN
  CLOSED
}

/// «Yo'q» javobidan chiqqan topshiriq. Mas'ul — erkin matn (bo'lim xodimlari tizimda hisob olmaydi).
model QcTask {
  id          String       @id @default(cuid())
  auditId     String
  audit       QcAudit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  deptId      String
  dept        QcDepartment @relation(fields: [deptId], references: [id])
  /// Qaysi nuqtadan chiqqani
  cpId        String
  what        String
  owner       String
  /// YYYY-MM-DD
  due         String       @db.VarChar(10)
  status      QcTaskStatus @default(OPEN)
  /// Qayta tekshirish: kim, qachon (kun), izoh
  checkedById String?
  checkedBy   User?        @relation(fields: [checkedById], references: [id])
  checkedOn   String?      @db.VarChar(10)
  checkNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([deptId, status, due])
  @@index([auditId])
}

// ── 2-bosqich: o'quv moduli va haftalik hisobot ──────────────────────────────

/// Bir bo'limning o'quv dasturi va testi (kontent). Ilovadan tahrirlanmaydi — fayldan (seed) yuklanadi.
/// `questions` ichida to'g'ri javob (answer, why) bor: brauzerga FAQAT test topshirilgandan keyin boradi.
model QcTraining {
  deptId    String       @id
  dept      QcDepartment @relation(fields: [deptId], references: [id], onDelete: Cascade)
  title     String
  intro     String       @default("")
  /// O'tish foizi
  passPct   Int          @default(70)
  /// [{ title, theory: [matn], tasks: [matn] }] — 5 ta kun
  days      Json
  /// [{ id, case, options: [4 matn], answer: indeks, why }]; bo'sh massiv — test yozilmagan
  questions Json
  updatedAt DateTime     @updatedAt
}

/// Xodim belgilagan o'quv topshirig'i. Kalit: d{kun}t{indeks}. Qayta bosilsa qator o'chadi.
model QcTrainingTask {
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deptId String
  dept   QcDepartment @relation(fields: [deptId], references: [id], onDelete: Cascade)
  key    String
  at     DateTime     @default(now())

  @@id([userId, deptId, key])
}

/// Test urinishi (cheklovsiz). Baholash serverda; `answers` = { savolId: tanlangan asl indeks }.
model QcTrainingAttempt {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deptId  String
  dept    QcDepartment @relation(fields: [deptId], references: [id], onDelete: Cascade)
  at      DateTime     @default(now())
  score   Int
  total   Int
  pct     Int
  passed  Boolean
  answers Json

  @@index([userId, deptId, at])
  @@index([at])
}

/// Haftalik hisobotga rahbar izohi. Kalit — dushanba sanasi (YYYY-MM-DD).
model QcReport {
  week      String   @id @db.VarChar(10)
  note      String   @default("")
  byId      String
  by        User     @relation(fields: [byId], references: [id])
  updatedAt DateTime @updatedAt
}

// ── Ishonchlilik: o'zgarishlar jurnali ───────────────────────────────────────

/// Muhim o'zgarishlar izi: kim, qachon, nima. Faqat qo'shiladi (o'zgartirilmaydi, o'chirilmaydi).
/// `details` — kerak bo'lsa tiklash uchun ma'lumot (masalan, o'chirilgan tekshiruv nusxasi).
model QcLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actorId  String
  actor    User     @relation(fields: [actorId], references: [id])
  /// audit.update, audit.delete, dept.save, dept.move, task.update, user.save, report.note
  action   String
  entity   String
  entityId String?
  summary  String
  details  Json?

  @@index([at])
  @@index([entity, entityId])
}
